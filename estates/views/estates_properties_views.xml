<?xml version="1.0"?>
<odoo>
    <record id="estates_properties_list" model="ir.actions.act_window">
        <!--<field name="name">List Properties Action</field>-->
        <field name="res_model">estates.properties</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Define a new lost reason
          </p><p>
            Use lost reasons to explain why an opportunity is lost.
          </p><p>
            Some examples of lost reasons: "We don't have people/skill", "Price too high"
          </p>
        </field>
    </record>

    <record id="estates_properties_list_view" model="ir.ui.view">
        <field name="name">List View</field>
        <field name="model">estates.properties</field>
        <field name="arch" type="xml">
            <list string="View">
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="availability"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="estates_properties_form" model="ir.ui.view">
        <field name="name">Form View</field>
        <field name="model">estates.properties</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="availability"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                             <group>
                            <field name="description"/>
                             </group>
                        </page>
                        <page string="Other infos">
                             <group>
                             </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estates_properties_search" model="ir.ui.view">
        <field name="name">Search View</field>
        <field name="model">estates.properties</field>
        <field name="arch" type="xml">
            <search string="Tests">
                <field name="name"/>
                <field name="availability"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
                <filter string="Available now" domain="['|',('state', '=', 'new'),('state', '=', 'offer_received')]"/>
                <filter string="Current state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
</odoo>
